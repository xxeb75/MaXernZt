{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaXernZt",
  "version": "0.18.1",
  "identifier": "fr.xxeb75.maxernzt",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MaXernZt",
        "width": 1500,
        "height": 950,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Sébastien Sonet",
    "copyright": "© Sébastien Sonet",
    "shortDescription": "Collage en papier découpé et animation",
    "longDescription": "MaXernZt : composer des collages en papier découpé (détourage par IA locale, ciseaux, déchirure, lettres, accessoires) et les animer (trajectoires, timeline, export vidéo).",
    "category": "GraphicsAndDesign",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
